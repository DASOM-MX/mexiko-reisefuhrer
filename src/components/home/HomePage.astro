---
/**
 * Homepage, design "3a / Warm editorial" (Claude Design: Facelift Home).
 *
 * Every word and image comes from the CMS:
 *   - the "home" entry for this locale (falls back to German)
 *   - featured "destinations" for the Sehenswürdigkeiten cards
 *   - the forms plugin for the contact form
 */
import { Image, PortableText } from "emdash/ui";
import { Form } from "@emdash-cms/plugin-forms/ui";
import Base from "../../layouts/Base.astro";
import IfRendered from "../IfRendered.astro";
import { LOCALES, galleryPath, localePath, t, type Locale } from "../../i18n/ui";
import type { HomeData } from "../../lib/content";

interface Props extends HomeData {
	locale: Locale;
}

const { locale, home, destinations } = Astro.props;
const ui = t(locale);
const d = home.data;
const heroImages = (d.hero_images ?? []).map((row) => row.image).filter(Boolean);
const gallery = (d.gallery ?? []).map((row) => row.image).filter(Boolean);
const credentials = d.credentials ?? [];
const steps = d.steps ?? [];
const isAdmin = !!Astro.locals.user;

const alternates = Object.fromEntries(LOCALES.map((l) => [l, localePath(l, "/")]));
const destinationUrl = (slug: string) => localePath(locale, `/sehenswuerdigkeiten/${slug}`);

/** Gallery tiles repeat the design's 7-tile mosaic: big, wide, 4 small, wide. */
const GALLERY_PATTERN = ["big", "wide", "", "", "", "", "wide"];
---

<Base
	title={d.hero_title}
	description={d.hero_text}
	locale={locale}
	alternates={alternates}
	content={{ collection: "home", id: d.id, slug: d.slug }}
>
	<div class="mx-home" data-reveal-root>
		<!-- Hero -->
		<section class="hero mx-wrap">
			<div class="hero__copy">
				<h1 {...home.edit.hero_title}>{d.hero_title}</h1>
				{d.hero_text && <p class="hero__lead" {...home.edit.hero_text}>{d.hero_text}</p>}
				<div class="hero__actions">
					{d.hero_cta_primary && <a class="mx-pill" href="#kontakt">{d.hero_cta_primary}</a>}
					{d.hero_cta_secondary && <a class="mx-link hero__secondary" href="#angebote">{d.hero_cta_secondary} →</a>}
				</div>
			</div>
			{
				heroImages.length > 0 && (
					<div class="hero__mosaic" {...home.edit.hero_images}>
						<div class="mx-media hero__main">
							<Image image={heroImages[0]} priority sizes="(max-width: 960px) 60vw, 420px" />
						</div>
						<div class="hero__stack">
							{heroImages.slice(1, 3).map((img) => (
								<div class="mx-media">
									<Image image={img} sizes="(max-width: 960px) 40vw, 300px" />
								</div>
							))}
						</div>
					</div>
				)
			}
		</section>

		<!-- Credentials -->
		{
			credentials.length > 0 && (
				<section class="creds" {...home.edit.credentials}>
					<div class="creds__grid mx-max">
						{credentials.map((c) => (
							<div class="creds__item">
								<h3 class="creds__title">{c.title}</h3>
								{c.text && <p class="creds__text">{c.text}</p>}
							</div>
						))}
					</div>
				</section>
			)
		}

		<!-- Offer / steps -->
		<section class="offer mx-wrap" id="angebote">
			<div class="split">
				<h2 {...home.edit.offer_title}>{d.offer_title}</h2>
				{d.offer_text && <p class="split__text" {...home.edit.offer_text}>{d.offer_text}</p>}
			</div>
			{
				steps.length > 0 && (
					<ol class="steps" {...home.edit.steps}>
						{steps.map((s, i) => (
							<li class="step">
								<span class="step__num">{String(i + 1).padStart(2, "0")}</span>
								<h3>{s.title}</h3>
								{s.text && <p>{s.text}</p>}
							</li>
						))}
					</ol>
				)
			}
		</section>

		<!-- Highlights -->
		{
			destinations.length > 0 && (
				<section class="highlights mx-wrap" id="sehenswuerdigkeiten">
					<div class="section-head">
						<h2 {...home.edit.highlights_title}>{d.highlights_title}</h2>
						{d.highlights_link_url && d.highlights_link_label && (
							<a class="mx-link" href={d.highlights_link_url}>{d.highlights_link_label} →</a>
						)}
					</div>
					<div class="highlights__grid">
						{destinations.map((dest) => (
							<a class="highlight mx-media" href={destinationUrl(dest.data.slug)}>
								{dest.data.featured_image && (
									<Image image={dest.data.featured_image} sizes="(max-width: 800px) 100vw, 700px" />
								)}
								<div class="highlight__caption">
									{dest.data.region && <p class="highlight__region">{dest.data.region}</p>}
									<h3 class="highlight__title">{dest.data.title}</h3>
								</div>
							</a>
						))}
					</div>
				</section>
			)
		}

		<!-- About -->
		<section class="about" id="ueber-mich">
			<div class="about__inner mx-max">
				{
					d.about_image && (
						<div class="mx-media about__photo" {...home.edit.about_image}>
							<Image image={d.about_image} sizes="(max-width: 800px) 70vw, 340px" />
						</div>
					)
				}
				<div>
					{d.about_eyebrow && <p class="eyebrow-accent" {...home.edit.about_eyebrow}>{d.about_eyebrow}</p>}
					{d.about_quote && <p class="about__quote" {...home.edit.about_quote}>{d.about_quote}</p>}
					{
						d.about_text && (
							<div class="about__text" {...home.edit.about_text}>
								<PortableText value={d.about_text} />
							</div>
						)
					}
					{
						d.about_link_url && d.about_link_label && (
							<a class="mx-link about__link" href={d.about_link_url}>{d.about_link_label} →</a>
						)
					}
				</div>
			</div>
		</section>

		<!-- Gallery -->
		{
			gallery.length > 0 && (
				<section class="gallery mx-wrap" id="galerie">
					<div class="section-head">
						<h2 {...home.edit.gallery_title}>{d.gallery_title}</h2>
						{d.gallery_link_label && (
							<a class="mx-link" href={galleryPath(locale)}>{d.gallery_link_label} →</a>
						)}
					</div>
					<div class="gallery__grid" {...home.edit.gallery}>
						{gallery.map((img, i) => (
							<div class:list={["mx-media", "gallery__tile", GALLERY_PATTERN[i % 7] && `gallery__tile--${GALLERY_PATTERN[i % 7]}`]}>
								<Image image={img} sizes="(max-width: 800px) 50vw, 420px" />
							</div>
						))}
					</div>
				</section>
			)
		}

		<!-- Contact -->
		<section class="contact" id="kontakt">
			<div class="contact__inner mx-max">
				<div>
					<h2 {...home.edit.contact_title}>{d.contact_title}</h2>
					{d.contact_text && <p class="contact__text" {...home.edit.contact_text}>{d.contact_text}</p>}
					{d.contact_note && <p class="contact__note" {...home.edit.contact_note}>{d.contact_note}</p>}
				</div>
				<div class="contact__form">
					{
						d.contact_form && (
							<IfRendered>
								<Form id={d.contact_form} />
								<Fragment slot="fallback">
									{isAdmin && (
										<p class="contact__setup">
											{ui.formMissing} <code>{d.contact_form}</code>
										</p>
									)}
								</Fragment>
							</IfRendered>
						)
					}
					{d.contact_privacy && <p class="contact__privacy">{d.contact_privacy}</p>}
				</div>
			</div>
		</section>
	</div>
</Base>

<script>
	/**
	 * Fade-in on scroll, ported from the 3a prototype: images ease in from
	 * scale(1.06), text rises 18px, siblings in the same grid stagger by 90ms.
	 * Nothing is hidden unless this script runs, and reduced motion opts out.
	 */
	const root = document.querySelector<HTMLElement>("[data-reveal-root]");
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (root && "IntersectionObserver" in window && !reduce) {
		const els = root.querySelectorAll<HTMLElement>(
			".mx-media, h1, h2, h3, p, .contact__form form",
		);
		const groups = new Map<Element, number>();
		const pending: HTMLElement[] = [];
		els.forEach((el) => {
			// Skip text inside a card that already animates as one unit.
			if (el.parentElement?.closest(".highlight")) return;
			const parent =
				el.parentElement?.closest(
					".hero__mosaic, .creds__grid, .steps, .highlights__grid, .gallery__grid, .split, .section-head",
				) ?? el.parentElement!;
			const i = groups.get(parent) ?? 0;
			groups.set(parent, i + 1);
			el.style.setProperty("--reveal-delay", `${Math.min(i, 5) * 90}ms`);
			el.classList.add(el.classList.contains("mx-media") ? "reveal-img" : "reveal");
			pending.push(el);
		});
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add("is-visible");
					io.unobserve(entry.target);
				}
			},
			{ threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
		);
		pending.forEach((el) => io.observe(el));
	}
</script>

<style>
	.mx-home {
		color: var(--mx-ink);
	}
	.mx-max {
		max-width: var(--mx-max);
		margin-inline: auto;
	}
	.mx-wrap {
		max-width: var(--mx-max);
		margin-inline: auto;
		padding-inline: var(--mx-gutter);
	}
	.mx-home h2 {
		font-size: clamp(34px, 3.2vw + 12px, 48px);
		line-height: 1.05;
		font-weight: 500;
		letter-spacing: -0.03em;
	}
	.mx-media {
		position: relative;
		overflow: hidden;
		border-radius: 8px;
		background: var(--mx-placeholder);
	}
	.mx-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}

	/* Reveal (classes are only added by the script) */
	.mx-home :global(.reveal),
	.mx-home :global(.reveal-img) {
		opacity: 0;
		transition:
			opacity 800ms var(--mx-ease) var(--reveal-delay, 0ms),
			transform 800ms var(--mx-ease) var(--reveal-delay, 0ms);
	}
	.mx-home :global(.reveal) {
		transform: translateY(18px);
	}
	.mx-home :global(.reveal-img) {
		transition-duration: 1100ms, 1400ms;
	}
	.mx-home :global(.reveal-img img) {
		transform: scale(1.06);
		transition: transform 1400ms var(--mx-ease) var(--reveal-delay, 0ms);
	}
	.mx-home :global(.is-visible) {
		opacity: 1;
		transform: none;
	}
	.mx-home :global(.is-visible img) {
		transform: none;
	}

	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 56px;
		align-items: end;
		padding-block: 80px 72px;
	}
	.hero h1 {
		font-size: clamp(40px, 3.6vw + 22px, 68px);
		line-height: 1.02;
		font-weight: 500;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}
	.hero__lead {
		max-width: 460px;
		margin: 28px 0 36px;
		font-size: 18px;
		line-height: 1.6;
		color: var(--mx-text-2);
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		align-items: center;
	}
	.hero__secondary {
		padding: 16px 22px;
	}
	.hero__mosaic {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 14px;
		height: 540px;
	}
	.hero__mosaic .mx-media {
		border-radius: 6px;
	}
	.hero__stack {
		display: grid;
		grid-template-rows: 1fr 1fr;
		gap: 14px;
		min-height: 0;
	}

	/* Credentials */
	.creds {
		border-block: 1px solid var(--mx-line);
	}
	.creds__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-inline: calc(var(--mx-gutter) / 2);
	}
	.creds__item {
		padding: 28px 32px;
		border-right: 1px solid var(--mx-line);
	}
	.creds__item:last-child {
		border-right: 0;
	}
	.creds__title {
		font-size: 22px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.creds__text {
		margin-top: 6px;
		font-size: 14px;
		line-height: 1.4;
		color: var(--mx-muted);
	}

	/* Offer */
	.offer {
		padding-block: 96px 88px;
	}
	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: end;
		margin-bottom: 40px;
	}
	.split__text {
		font-size: 17px;
		line-height: 1.6;
		color: var(--mx-text-2);
	}
	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		list-style: none;
	}
	.step {
		padding: 32px;
		border-radius: 10px;
		background: var(--mx-surface);
	}
	.step__num {
		font-size: 13px;
		font-weight: 500;
		color: var(--mx-accent);
	}
	.step h3 {
		margin: 28px 0 8px;
		font-size: 22px;
		font-weight: 500;
	}
	.step p {
		font-size: 15px;
		line-height: 1.55;
		color: var(--mx-text-2);
	}

	/* Highlights */
	.highlights {
		padding-bottom: 96px;
		scroll-margin-top: 24px;
	}
	.section-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px 24px;
		margin-bottom: 28px;
	}
	.section-head .mx-link {
		font-size: 15px;
	}
	.highlights__grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 20px;
	}
	.highlight {
		display: block;
		height: 460px;
		border-radius: 10px;
		color: #fff;
		text-decoration: none;
	}
	.highlight :global(img) {
		transition: transform 900ms var(--mx-ease);
	}
	.highlight:hover :global(img) {
		transform: scale(1.03);
	}
	.highlight:focus-visible {
		outline: 2px solid var(--mx-accent);
		outline-offset: 3px;
	}
	.highlight__caption {
		position: absolute;
		inset: auto 0 0 0;
		padding: 28px;
		background: linear-gradient(0deg, rgb(25 18 12 / 0.6), rgb(25 18 12 / 0));
	}
	.highlight__region {
		font-size: 13px;
		opacity: 0.85;
	}
	.highlight__title {
		margin-top: 4px;
		font-size: 30px;
		font-weight: 500;
		letter-spacing: -0.02em;
		color: #fff;
	}

	/* About */
	.about {
		margin-bottom: 96px;
		background: var(--mx-sand);
	}
	.about__inner {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: 72px;
		align-items: center;
		padding: 88px var(--mx-gutter);
	}
	.about__photo {
		aspect-ratio: 4 / 5;
		background: repeating-linear-gradient(135deg, #ddd2c4 0 8px, #e5dbcf 8px 16px);
	}
	.eyebrow-accent {
		margin-bottom: 18px;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--mx-accent);
	}
	.about__quote {
		font-size: clamp(22px, 1.6vw + 12px, 32px);
		line-height: 1.3;
		letter-spacing: -0.02em;
		text-wrap: pretty;
	}
	.about__text {
		max-width: 620px;
		margin-top: 26px;
		font-size: 16px;
		line-height: 1.65;
		color: var(--mx-text-2);
	}
	.about__text :global(strong) {
		font-weight: 600;
		color: var(--mx-ink);
	}
	.about__text :global(p + p) {
		margin-top: 1em;
	}
	.about__link {
		display: inline-block;
		margin-top: 24px;
		font-size: 15px;
	}

	/* Gallery */
	.gallery {
		padding-bottom: 96px;
	}
	.gallery__grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		grid-auto-rows: 180px;
		gap: 12px;
	}
	.gallery__tile--big {
		grid-column: span 2;
		grid-row: span 2;
	}
	.gallery__tile--wide {
		grid-column: span 2;
	}

	/* Contact */
	.contact {
		background: var(--mx-dark);
		color: var(--mx-on-dark);
	}
	.contact__inner {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 72px;
		padding: 88px var(--mx-gutter);
	}
	.contact h2 {
		color: var(--mx-on-dark);
	}
	.contact__text {
		max-width: 420px;
		margin-top: 20px;
		font-size: 17px;
		line-height: 1.6;
		color: var(--mx-on-dark-2);
	}
	.contact__note {
		margin-top: 28px;
		font-size: 14px;
		color: var(--mx-on-dark-3);
	}
	.contact__privacy {
		margin-top: 14px;
		font-size: 13px;
		color: var(--mx-on-dark-3);
	}
	.contact__setup {
		padding: 18px;
		border: 1px dashed var(--mx-on-dark-3);
		border-radius: 8px;
		font-size: 14px;
		line-height: 1.5;
		color: var(--mx-on-dark-2);
	}

	/* Forms plugin markup, styled as the 3a dark fields */
	.contact__form :global(.ec-form-page) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	.contact__form :global(.ec-form-field) {
		grid-column: span 2;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 14px 18px;
		border-radius: 8px;
		background: var(--mx-dark-2);
		transition: box-shadow 150ms ease;
	}
	.contact__form :global(.ec-form-field--half) {
		grid-column: span 1;
	}
	.contact__form :global(.ec-form-field--hidden) {
		display: none;
	}
	.contact__form :global(.ec-form-field:focus-within) {
		box-shadow: 0 0 0 2px var(--mx-accent);
	}
	.contact__form :global(.ec-form-label) {
		font-size: 12px;
		color: var(--mx-on-dark-4);
	}
	.contact__form :global(.ec-form-required) {
		margin-left: 2px;
		color: var(--mx-on-dark-3);
	}
	.contact__form :global(.ec-form-input) {
		width: 100%;
		min-height: 22px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--mx-on-dark);
		font: inherit;
		font-size: 16px;
		outline: none;
	}
	.contact__form :global(textarea.ec-form-input) {
		min-height: 96px;
		resize: vertical;
	}
	.contact__form :global(select.ec-form-input option) {
		color: var(--mx-ink);
	}
	.contact__form :global(.ec-form-help),
	.contact__form :global(.ec-form-error) {
		font-size: 12px;
		color: var(--mx-on-dark-3);
	}
	.contact__form :global(.ec-form-error) {
		color: #f0b9a4;
	}
	.contact__form :global(.ec-form-checkbox-label),
	.contact__form :global(.ec-form-radio-label) {
		display: flex;
		gap: 8px;
		align-items: center;
		font-size: 14px;
		color: var(--mx-on-dark-2);
	}
	.contact__form :global(.ec-form-nav) {
		display: flex;
		justify-content: flex-end;
		gap: 12px;
		margin-top: 20px;
	}
	.contact__form :global(.ec-form-submit),
	.contact__form :global(.ec-form-next),
	.contact__form :global(.ec-form-prev) {
		padding: 15px 28px;
		border: 0;
		border-radius: 999px;
		background: var(--mx-on-dark);
		color: var(--mx-ink);
		font: inherit;
		font-weight: 500;
		cursor: pointer;
	}
	.contact__form :global(.ec-form-prev) {
		background: transparent;
		color: var(--mx-on-dark);
	}
	.contact__form :global(.ec-form-submit:hover) {
		background: #fff;
	}
	.contact__form :global(.ec-form-submit:focus-visible) {
		outline: 2px solid var(--mx-accent);
		outline-offset: 3px;
	}
	.contact__form :global(.ec-form-status) {
		margin-top: 14px;
		font-size: 15px;
		color: var(--mx-on-dark);
	}

	/* ── Responsive (the design is desktop-only; these keep its character) ── */
	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 40px;
			padding-block: 48px 56px;
		}
		.hero__mosaic {
			height: auto;
			aspect-ratio: 4 / 3;
		}
		.creds__grid {
			grid-template-columns: repeat(2, 1fr);
			padding-inline: 0;
		}
		.creds__item {
			padding: 24px var(--mx-gutter);
		}
		.creds__item:nth-child(2n) {
